{
  "expo": {
    "name": "Routine",
    "slug": "routine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "routine",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.routine.v0",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Routine uses notifications to tell you when a timer section finishes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.routine.v0",
      "adaptiveIcon": {
        "backgroundColor": "#F4EFE8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4EFE8"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/chime.wav"
          ],
          "defaultChannel": "timer"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f17e8c5-95dd-4ab4-bfcc-68192002674a"
      }
    }
  }
}
